#!/usr/bin/env bash

set -Eeuo pipefail

APP_DIR="/root/LyingMan"
SERVICE_NAME="lyingman"
SOURCE_REPO="https://github.com/linchuming/LyingMan.git"

NODE_VERSION="4.9.1"
WEB_PORT="81"
WS_PORT="8080"

NVM_DIR="/root/.nvm"
NODE_BIN="${NVM_DIR}/versions/node/v${NODE_VERSION}/bin/node"
NPM_BIN="${NVM_DIR}/versions/node/v${NODE_VERSION}/bin/npm"

NGINX_CONF="/etc/nginx/sites-available/lyingman"
NGINX_LINK="/etc/nginx/sites-enabled/lyingman"

BACKUP_DIR="/root"

DOMAIN_FILE="/root/.lyingman_domain"


# =========================================================
# 基础函数
# =========================================================

pause() {
    echo
    read -r -p "按 Enter 返回菜单..." _
}

print_line() {
    echo "=============================================="
}

error_exit() {
    echo
    echo "❌ 操作失败：$1"
    echo
    exit 1
}

check_root() {
    if [ "$(id -u)" != "0" ]; then
        error_exit "请使用 root 用户运行此脚本。"
    fi
}

install_basic_packages() {
    echo
    echo "正在安装基础依赖..."

    apt-get update

    apt-get install -y \
        git \
        curl \
        wget \
        nginx \
        openssl \
        build-essential \
        ca-certificates \
        python3 \
        certbot \
        python3-certbot-nginx

    echo "✅ 基础依赖安装完成"
}


# =========================================================
# Node.js / NVM
# =========================================================

install_node() {

    echo
    echo "=============================================="
    echo "        安装 Node.js ${NODE_VERSION}"
    echo "=============================================="

    export NVM_DIR="${NVM_DIR}"

    if [ ! -s "${NVM_DIR}/nvm.sh" ]; then

        echo "正在安装 NVM..."

        curl -fsSL \
            https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh \
            | bash

    fi

    export NVM_DIR="${NVM_DIR}"

    if [ -f "${NVM_DIR}/nvm.sh" ]; then
        source "${NVM_DIR}/nvm.sh"
    else
        error_exit "NVM 安装失败。"
    fi

    echo "正在安装 Node.js ${NODE_VERSION}..."

    if ! nvm ls "${NODE_VERSION}" >/dev/null 2>&1; then
        nvm install "${NODE_VERSION}"
    fi

    nvm alias default "${NODE_VERSION}" >/dev/null 2>&1 || true
    nvm use "${NODE_VERSION}" >/dev/null 2>&1 || true

    if [ ! -x "${NODE_BIN}" ]; then
        error_exit "Node.js ${NODE_VERSION} 安装失败。"
    fi

    echo
    echo "Node:"
    "${NODE_BIN}" -v

    echo "NPM:"
    "${NPM_BIN}" -v

    echo
    echo "✅ Node.js 安装完成"
}


# =========================================================
# 修复 package.json
# =========================================================

fix_package_json() {

    local SERVER_DIR="${APP_DIR}/server"
    local SERVER_PACKAGE="${SERVER_DIR}/package.json"

    if [ ! -f "${SERVER_PACKAGE}" ]; then
        error_exit "找不到 ${SERVER_PACKAGE}"
    fi

    echo
    echo "检查 package.json..."

    if grep -q '"name"[[:space:]]*:[[:space:]]*"LyingMan Server"' "${SERVER_PACKAGE}"; then

        echo "发现旧项目存在非法 npm 名称：LyingMan Server"
        echo "正在修复为：lyingman-server"

        sed -i \
            's/"name"[[:space:]]*:[[:space:]]*"LyingMan Server"/"name": "lyingman-server"/' \
            "${SERVER_PACKAGE}"

        echo "✅ package.json 已修复"

    else

        echo "✅ package.json 无需修复"

    fi
}


# =========================================================
# 创建 systemd
# =========================================================

create_service() {

    echo
    echo "正在创建 systemd 服务..."

    cat > "/etc/systemd/system/${SERVICE_NAME}.service" <<EOF
[Unit]
Description=LyingMan Werewolf Game Server
After=network.target

[Service]
Type=simple
WorkingDirectory=${APP_DIR}
ExecStart=${NODE_BIN} ${APP_DIR}/server/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable "${SERVICE_NAME}"

    echo "✅ systemd 服务创建完成"
}


# =========================================================
# 安装 / 重新安装
# =========================================================

install_lyingman() {

    print_line
    echo "          安装 / 重新安装 LyingMan"
    print_line

    install_basic_packages
    install_node

    # 备份旧目录
    if [ -d "${APP_DIR}" ]; then

        BACKUP_NAME="LyingMan.backup.$(date +%Y%m%d_%H%M%S)"

        echo
        echo "发现旧版 LyingMan。"
        echo "正在备份到：${BACKUP_DIR}/${BACKUP_NAME}"

        mv "${APP_DIR}" "${BACKUP_DIR}/${BACKUP_NAME}"

        echo "✅ 旧版本已备份"
    fi

    echo
    echo "正在下载 LyingMan..."

    git clone "${SOURCE_REPO}" "${APP_DIR}"

    echo "✅ LyingMan 下载完成"

    SERVER_DIR="${APP_DIR}/server"

    if [ ! -d "${SERVER_DIR}" ]; then
        error_exit "找不到 server 目录。"
    fi

    fix_package_json

    echo
    echo "正在安装项目依赖..."

    cd "${SERVER_DIR}"

    "${NPM_BIN}" install --unsafe-perm

    echo
    echo "✅ 项目依赖安装完成"

    create_service

    echo
    echo "正在启动 LyingMan..."

    systemctl restart "${SERVICE_NAME}"

    sleep 3

    if systemctl is-active --quiet "${SERVICE_NAME}"; then
        echo "✅ LyingMan 启动成功"
    else
        echo "❌ LyingMan 启动失败"
        systemctl status "${SERVICE_NAME}" --no-pager
        return 1
    fi

    configure_network

    echo
    echo "=============================================="
    echo "           LyingMan 安装完成"
    echo "=============================================="

    show_status

    pause
}


# =========================================================
# Nginx + 域名 / IP
# =========================================================

configure_network() {

    echo
    print_line
    echo "           配置网站访问方式"
    print_line

    echo
    echo "请输入你的域名。"
    echo "如果没有域名，直接按 Enter 使用 IP + HTTP。"
    echo

    read -r -p "域名: " DOMAIN

    if [ -z "${DOMAIN}" ]; then

        echo
        echo "未输入域名。"
        echo "正在配置 IP + HTTP + WS..."

        rm -f "${NGINX_LINK}"

        cat > "${NGINX_CONF}" <<EOF
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name _;

    location /ws/ {
        proxy_pass http://127.0.0.1:${WS_PORT}/;

        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;

        proxy_read_timeout 86400;
    }

    location / {
        proxy_pass http://127.0.0.1:${WEB_PORT};

        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    }
}
EOF

        ln -sf "${NGINX_CONF}" "${NGINX_LINK}"

        nginx -t
        systemctl enable nginx
        systemctl restart nginx

        rm -f "${DOMAIN_FILE}"

        echo
        echo "✅ IP + HTTP + WS 配置完成"

        SERVER_IP="$(curl -4 -s https://icanhazip.com || true)"

        echo
        echo "访问地址："
        echo "http://${SERVER_IP}"

    else

        echo
        echo "检测到域名：${DOMAIN}"
        echo "正在配置 HTTPS + WSS..."

        echo "${DOMAIN}" > "${DOMAIN_FILE}"

        rm -f "${NGINX_LINK}"

        cat > "${NGINX_CONF}" <<EOF
server {
    listen 80;
    listen [::]:80;

    server_name ${DOMAIN};

    location / {
        proxy_pass http://127.0.0.1:${WEB_PORT};

        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    }

    location /ws/ {
        proxy_pass http://127.0.0.1:${WS_PORT}/;

        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;

        proxy_read_timeout 86400;
    }
}
EOF

        ln -sf "${NGINX_CONF}" "${NGINX_LINK}"

        nginx -t
        systemctl enable nginx
        systemctl restart nginx

        echo
        echo "正在申请 SSL 证书..."

        certbot --nginx \
            -d "${DOMAIN}" \
            --non-interactive \
            --agree-tos \
            --register-unsafely-without-email \
            --redirect

        echo
        echo "✅ HTTPS + WSS 配置完成"

        echo
        echo "访问地址："
        echo "https://${DOMAIN}"
    fi
}


# =========================================================
# 启动
# =========================================================

start_service() {

    systemctl start "${SERVICE_NAME}"

    sleep 2

    if systemctl is-active --quiet "${SERVICE_NAME}"; then
        echo "✅ LyingMan 已启动"
    else
        echo "❌ 启动失败"
        systemctl status "${SERVICE_NAME}" --no-pager
    fi

    pause
}


# =========================================================
# 停止
# =========================================================

stop_service() {

    systemctl stop "${SERVICE_NAME}" || true

    echo
    echo "✅ LyingMan 已停止"

    pause
}


# =========================================================
# 重启
# =========================================================

restart_service() {

    systemctl restart "${SERVICE_NAME}"

    sleep 2

    if systemctl is-active --quiet "${SERVICE_NAME}"; then
        echo "✅ LyingMan 已重启"
    else
        echo "❌ 重启失败"
        systemctl status "${SERVICE_NAME}" --no-pager
    fi

    pause
}


# =========================================================
# 状态
# =========================================================

show_status() {

    echo
    print_line
    echo "              LyingMan 状态"
    print_line

    echo
    systemctl status "${SERVICE_NAME}" --no-pager || true

    echo
    echo "监听端口："

    ss -lntp 2>/dev/null | grep -E ":(${WEB_PORT}|${WS_PORT})" || true

    echo

    if [ -f "${DOMAIN_FILE}" ]; then

        DOMAIN="$(cat "${DOMAIN_FILE}")"

        echo "域名：${DOMAIN}"
        echo "网站：https://${DOMAIN}"
        echo "WebSocket：wss://${DOMAIN}/ws/"

    else

        SERVER_IP="$(curl -4 -s https://icanhazip.com || true)"

        echo "IP：${SERVER_IP}"
        echo "网站：http://${SERVER_IP}"
        echo "WebSocket：ws://${SERVER_IP}/ws/"

    fi

    pause
}


# =========================================================
# 日志
# =========================================================

show_logs() {

    echo
    print_line
    echo "             LyingMan 实时日志"
    print_line

    echo
    echo "按 Ctrl+C 退出日志。"
    echo

    journalctl -u "${SERVICE_NAME}" -f
}


# =========================================================
# 删除
# =========================================================

delete_lyingman() {

    print_line
    echo "              删除 LyingMan"
    print_line

    echo
    echo "⚠️  警告："
    echo
    echo "这将删除："
    echo "- LyingMan 程序"
    echo "- systemd 服务"
    echo "- Nginx 配置"
    echo "- 域名配置"
    echo
    echo "以前创建的备份目录不会删除。"
    echo

    read -r -p "确定要删除吗？ [y/N]: " CONFIRM

    if [[ ! "${CONFIRM}" =~ ^[Yy]$ ]]; then
        echo
        echo "已取消删除。"
        pause
        return
    fi

    echo
    echo "开始删除..."

    systemctl stop "${SERVICE_NAME}" 2>/dev/null || true
    systemctl disable "${SERVICE_NAME}" 2>/dev/null || true

    rm -f "/etc/systemd/system/${SERVICE_NAME}.service"

    systemctl daemon-reload

    rm -rf "${APP_DIR}"

    rm -f "${NGINX_LINK}"
    rm -f "${NGINX_CONF}"

    rm -f "${DOMAIN_FILE}"

    nginx -t >/dev/null 2>&1 && systemctl reload nginx || true

    echo
    echo "=============================================="
    echo "          LyingMan 已删除"
    echo "=============================================="

    pause
}


# =========================================================
# 修改域名
# =========================================================

change_domain() {

    print_line
    echo "              修改域名 / HTTPS"
    print_line

    echo
    echo "请输入新的域名。"
    echo "如果想改成 IP + HTTP，直接按 Enter。"
    echo

    read -r -p "新域名: " NEW_DOMAIN

    if [ -z "${NEW_DOMAIN}" ]; then

        rm -f "${DOMAIN_FILE}"

        configure_network

    else

        echo "${NEW_DOMAIN}" > "${DOMAIN_FILE}"

        configure_network

    fi

    pause
}


# =========================================================
# 更新项目
# =========================================================

update_lyingman() {

    print_line
    echo "              更新 LyingMan"
    print_line

    if [ ! -d "${APP_DIR}/.git" ]; then
        echo
        echo "❌ 没有找到 LyingMan Git 仓库。"
        echo "请使用“1. 安装 / 重新安装”。"
        pause
        return
    fi

    echo
    echo "正在停止服务..."

    systemctl stop "${SERVICE_NAME}" || true

    echo "正在更新代码..."

    cd "${APP_DIR}"

    git fetch origin
    git reset --hard origin/main

    fix_package_json

    echo
    echo "正在重新安装依赖..."

    cd "${APP_DIR}/server"

    "${NPM_BIN}" install --unsafe-perm

    echo
    echo "正在启动服务..."

    systemctl daemon-reload
    systemctl restart "${SERVICE_NAME}"

    sleep 3

    if systemctl is-active --quiet "${SERVICE_NAME}"; then
        echo
        echo "✅ LyingMan 更新完成"
    else
        echo
        echo "❌ 更新后启动失败"

        systemctl status "${SERVICE_NAME}" --no-pager
    fi

    pause
}


# =========================================================
# 主菜单
# =========================================================

main_menu() {

    while true; do

        clear

        echo
        print_line
        echo "          LyingMan 狼人杀管理脚本"
        print_line
        echo

        echo "  1. 安装 / 重新安装"
        echo "  2. 启动"
        echo "  3. 停止"
        echo "  4. 重启"
        echo "  5. 查看状态"
        echo "  6. 查看日志"
        echo "  7. 删除 LyingMan"
        echo "  8. 修改域名 / HTTPS"
        echo "  9. 更新 LyingMan"
        echo "  0. 退出"

        echo
        print_line

        read -r -p "请选择 [0-9]: " CHOICE

        case "${CHOICE}" in

            1)
                install_lyingman
                ;;

            2)
                start_service
                ;;

            3)
                stop_service
                ;;

            4)
                restart_service
                ;;

            5)
                show_status
                ;;

            6)
                show_logs
                ;;

            7)
                delete_lyingman
                ;;

            8)
                change_domain
                ;;

            9)
                update_lyingman
                ;;

            0)
                echo
                echo "退出。"
                exit 0
                ;;

            *)
                echo
                echo "❌ 无效选项，请输入 0-9。"
                sleep 1
                ;;

        esac

    done
}


# =========================================================
# 启动
# =========================================================

check_root
main_menu
